{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f0e4" },
      "foreground": { "$value": "#172323" },
      "border": { "$value": "#c8d1c8" },
      "card": { "$value": "#fffaf0" },
      "cardForeground": { "$value": "#172323" },
      "popover": { "$value": "#fffaf0" },
      "popoverForeground": { "$value": "#172323" },
      "primary": {
        "$value": "#e87128",
        "$description": "Orangey orange. Drives primary actions, active states, and key progress."
      },
      "primaryForeground": { "$value": "#172323" },
      "secondary": { "$value": "#dce9e4" },
      "secondaryForeground": { "$value": "#173d3a" },
      "muted": { "$value": "#e8e4da" },
      "mutedForeground": { "$value": "#5f706b" },
      "accent": { "$value": "#efb94c" },
      "accentForeground": { "$value": "#172323" },
      "destructive": { "$value": "#d94f3d" },
      "destructiveForeground": { "$value": "#fffaf0" },
      "input": { "$value": "#b9c8c2" },
      "ring": { "$value": "#e87128" },
      "chart1": { "$value": "#e87128" },
      "chart2": { "$value": "#3d8f86" },
      "chart3": { "$value": "#efb94c" },
      "chart4": { "$value": "#b86c91" },
      "chart5": { "$value": "#526f8c" },
      "sidebar": { "$value": "#e6ede8" },
      "sidebarForeground": { "$value": "#314540" },
      "sidebarBorder": { "$value": "#c0cdc7" },
      "sidebarPrimary": { "$value": "#e87128" },
      "sidebarPrimaryForeground": { "$value": "#172323" },
      "sidebarAccent": { "$value": "#d3e2dc" },
      "sidebarAccentForeground": { "$value": "#173d3a" },
      "sidebarRing": { "$value": "#e87128" }
    },
    "dark": {
      "background": { "$value": "#081112" },
      "foreground": { "$value": "#eee7d7" },
      "border": { "$value": "#344343" },
      "card": { "$value": "#101a1b" },
      "cardForeground": { "$value": "#eee7d7" },
      "popover": { "$value": "#152323" },
      "popoverForeground": { "$value": "#eee7d7" },
      "primary": { "$value": "#e87128" },
      "primaryForeground": { "$value": "#152021" },
      "secondary": { "$value": "#1a2929" },
      "secondaryForeground": { "$value": "#c9d2c8" },
      "muted": { "$value": "#172323" },
      "mutedForeground": { "$value": "#8ca6a0" },
      "accent": { "$value": "#efb94c" },
      "accentForeground": { "$value": "#152021" },
      "destructive": { "$value": "#f06445" },
      "destructiveForeground": { "$value": "#fff4ec" },
      "input": { "$value": "#405351" },
      "ring": { "$value": "#efb94c" },
      "chart1": { "$value": "#e87128" },
      "chart2": { "$value": "#78b8ac" },
      "chart3": { "$value": "#efb94c" },
      "chart4": { "$value": "#c88da7" },
      "chart5": { "$value": "#6d91b5" },
      "sidebar": { "$value": "#121d1d" },
      "sidebarForeground": { "$value": "#d9dfd5" },
      "sidebarBorder": { "$value": "#334141" },
      "sidebarPrimary": { "$value": "#e87128" },
      "sidebarPrimaryForeground": { "$value": "#152021" },
      "sidebarAccent": { "$value": "#243737" },
      "sidebarAccentForeground": { "$value": "#f2ead9" },
      "sidebarRing": { "$value": "#efb94c" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Warm, legible product UI and explanatory copy."
      },
      "serif": { "$value": ["DM Sans", "sans-serif"] },
      "mono": {
        "$value": ["Space Mono", "monospace"],
        "$description": "Technical labels, channel IDs, values, and status readouts."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Friendly hardware-softened corners; precise controls stay compact."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
