{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/runAll.ts",
    "validate:native-controls": "tsx scripts/validateNativeControls.ts",
    "validate:native-instrument": "tsx scripts/validateNativeInstrument.ts",
    "test:e2e": "tsx tests/e2eSmokeTest.ts && npm run test:e2e:daw",
    "test:e2e:daw": "tsx tests/e2eDawTest.ts",
    "test:e2e:daw-sync": "tsx tests/e2eDawSyncTest.ts",
    "test:daw": "tsx tests/dawCoreTest.ts && tsx tests/dawContractTest.ts && tsx tests/dawSyncTest.ts",
    "audit": "tsx scripts/knowledgeAuditReport.ts",
    "desktop:configure": "cmake -S desktop -B desktop/build -DCMAKE_BUILD_TYPE=Release",
    "desktop:build": "cmake --build desktop/build --config Release",
    "desktop:golden": "tsx tests/desktopGoldenTest.ts && tsx tests/desktopScaffoldContractTest.ts",
    "desktop:golden:native": "tsx scripts/desktopNativeGate.ts",
    "desktop:devices": "tsx scripts/desktopListAudioDevices.ts",
    "desktop:latency": "tsx scripts/desktopLatencyBenchmark.ts",
    "desktop:latency:aggregate": "tsx scripts/aggregateDesktopLatencyEvidence.ts",
    "desktop:release:metadata": "node scripts/desktopReleaseManifest.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@clerk/react": "^6.14.7",
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
